# Chave da Steam Web API: https://steamcommunity.com/dev/apikey (grátis, instantânea)
STEAM_API_KEY=

# Supabase: crie um projeto grátis em https://supabase.com, depois
# Project Settings > API para achar essas 3 chaves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo aleatório pra assinar o cookie de sessão. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL pública do site, usada no login da Steam (deve bater exatamente com o domínio
# em que o site está rodando). Em desenvolvimento local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
